# LLM provider: mock | openai | azure (mock works without keys)
LLM_PROVIDER=mock

# Optional real LLM settings (not required for this project)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Token and input limits
MAX_TICKET_CHARS=4000
MAX_PROMPT_TOKENS=3000

# Analysis reference date (YYYY-MM-DD) for RFM
RFM_REFERENCE_DATE=2025-09-30

# Embedding backend: sklearn | sentence_transformers
EMBEDDING_BACKEND=sklearn

# Paths (defaults use project root)
# PROJECT_ROOT=
